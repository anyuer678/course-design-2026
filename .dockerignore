# Version control / local tooling
.git
.workbuddy/
scripts/
node_modules/

# Runtime data & credentials - NEVER bake into images (named volumes take over)
**/__pycache__/
**/*.pyc
**/data/
**/runs/
**/logs/
**/backup/
**/*.sqlite
**/*.sqlite3
**/password.txt
**/secret.key
courselab/config.json

# Big dirs / draft docs irrelevant to any container
# （g2 只放行 cards.json：courselab 运行时读它当课程内容源，courses.py:15）
p-验收/
thesis/
g2/*
!g2/cards.json
board/
webkit/
screenshots/
ACCIDENT-2026-10-02.md
.venv/
